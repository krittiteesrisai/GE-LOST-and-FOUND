rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }

    match /items/{item} {
      // 1. อนุญาตให้ทุกคนอ่านได้
      allow read: if true;
      
      // 2. อนุญาตให้ทุกคน create ได้ แต่ต้องเช็คฟิลด์และค่าไม่ว่างเปล่า
      allow create: if request.resource.data.keys().hasAll(['title', 'category', 'description', 'location', 'date', 'contact', 'type'])
                    && request.resource.data.title is string && request.resource.data.title.trim() != ''
                    && request.resource.data.category is string && request.resource.data.category.trim() != ''
                    && request.resource.data.description is string && request.resource.data.description.trim() != ''
                    && request.resource.data.location is string && request.resource.data.location.trim() != ''
                    && request.resource.data.date is string && request.resource.data.date.trim() != ''
                    && request.resource.data.contact is string && request.resource.data.contact.trim() != ''
                    && request.resource.data.type is string && request.resource.data.type.trim() != '';
                    
      // 3. อนุญาตให้ทุกคน update ได้ภายใต้เงื่อนไขข้อมูล (เนื่องจากเราถอยกลับมาใช้ Client-side Admin Auth)
      allow update: if request.resource.data.title is string && request.resource.data.title.trim() != ''
                    && request.resource.data.category is string && request.resource.data.category.trim() != ''
                    && request.resource.data.description is string && request.resource.data.description.trim() != ''
                    && request.resource.data.location is string && request.resource.data.location.trim() != ''
                    && request.resource.data.date is string && request.resource.data.date.trim() != ''
                    && request.resource.data.contact is string && request.resource.data.contact.trim() != '';
      
      // 4. อนุญาตให้ทุกคน delete ได้ (เนื่องจากเราถอยกลับมาใช้ Client-side Admin Auth)
      allow delete: if true;
    }
  }
}
